<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div>
        <h3>Registration Form</h3>
        <form action="/register" method="post">
             <input type="text" name="fname" id="fname" placeholder="enter your first name"><br><br>
             <input type="text" name="lname" id="lname" placeholder="enter your last  name"><br><br>
             <input type="text" name="uname" id="uname" placeholder="enter your user name"><br><br>
             <input type="email" name="email" id="email" placeholder="enter your email"><br><br>
            <input type="submit">
        </form>
    </div>
</body>
</html>